  "a1_ontology": [
    {
      "name": "motion_intensity",
      "definition": "Overall magnitude and energy of motion within a window, including both linear and rotational components.",
      "levels": {
        "Low": "Weak or nearly static motion.",
        "Medium": "Moderate motion magnitude and energy.",
        "High": "Strong or vigorous motion."
      }
    },
    {
      "name": "cadence",
      "definition": "Rate at which a meaningful periodic motion unit repeats over time. Cadence measures repetitions per unit time, not the total number of repetitions in the recording.",
      "levels": {
        "Low": "No clear periodic repetition or a slow repetition rate.",
        "Medium": "Moderate repetition rate.",
        "High": "Fast repetition rate."
      }
    },
    {
      "name": "smoothness",
      "definition": "Degree to which motion changes continuously rather than through sustained rapid fluctuations.",
      "levels": {
        "Low": "Frequent or sustained abrupt fluctuations.",
        "Medium": "Moderately smooth motion with some fluctuations.",
        "High": "Continuous and smooth motion with little fluctuation."
      }
    },
    {
      "name": "impulsiveness",
      "definition": "Degree to which motion contains short, abrupt, high-magnitude changes or impacts.",
      "levels": {
        "Low": "Few or no pronounced abrupt peaks.",
        "Medium": "Moderate abrupt peaks or impacts.",
        "High": "Strong short-duration peaks or impacts."
      }
    },
    {
      "name": "posture_inclination",
      "definition": "Average gravity-relative inclination of the global load-bearing body configuration within a window, rather than the orientation of an isolated moving limb.",
      "levels": {
        "Low": "Nearly upright relative to gravity.",
        "Medium": "Moderately inclined relative to gravity.",
        "High": "Strongly inclined or nearly horizontal relative to gravity."
      }
    },
    {
      "name": "posture_variability",
      "definition": "Extent to which the global load-bearing body configuration changes relative to gravity within a window, rather than local limb-orientation changes.",
      "levels": {
        "Low": "Posture remains nearly constant.",
        "Medium": "Posture changes moderately.",
        "High": "Posture changes substantially."
      }
    },
    {
      "name": "rotational_motion",
      "definition": "Prominence of angular or rotational motion during the activity.",
      "levels": {
        "Low": "Little or no rotational motion.",
        "Medium": "Moderate rotational motion.",
        "High": "Prominent rotational motion."
      }
    },
    {
      "name": "translational_motion",
      "definition": "Prominence of sustained linear progression or locomotor translation within a window.",
      "levels": {
        "Low": "Little or no sustained translation.",
        "Medium": "Moderate translational motion.",
        "High": "Prominent sustained translational or locomotor motion."
      }
    },
    {
      "name": "motion_regularity",
      "definition": "Temporal consistency and predictability of the motion pattern.",
      "levels": {
        "Low": "Irregular and poorly predictable motion pattern.",
        "Medium": "Partly structured motion with moderate variability.",
        "High": "Consistent and predictable motion pattern."
      }
    }
  ],
